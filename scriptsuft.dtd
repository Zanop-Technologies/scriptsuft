<!-- =====================================================================
     Scriptsuft DTD — ported from WML (Website Markup Language)

     Scriptsuft is based on WML, a discontinued markup language.
     This DTD contains the elements retained for Scriptsuft.

     Status:
       COMPLETED — confirmed/implemented in Scriptsuft.
       CARRIED OVER UNCONFIRMED — intentionally retained as a historical
       reference only and not part of the active Scriptsuft grammar.

     WML-specific experimental components have been removed from
     Scriptsuft:
       object, imp, comp, use, slot, state, bind, rep, if, else,
       route, tok
     ===================================================================== -->


<!-- ========================= Imported Names =========================== -->

<!ENTITY % ContentType "CDATA">
<!ENTITY % ContentTypes "CDATA">
<!ENTITY % Charset "CDATA">
<!ENTITY % Charsets "CDATA">
<!ENTITY % LanguageCode "NAME">
<!ENTITY % Character "CDATA">
<!ENTITY % LinkTypes "CDATA">
<!ENTITY % MediaDesc "CDATA">
<!ENTITY % URI "CDATA">
<!ENTITY % Datetime "CDATA">
<!ENTITY % Script "CDATA">
<!ENTITY % StyleSheet "CDATA">
<!ENTITY % Text "CDATA">
<!ENTITY % Length "CDATA">
<!ENTITY % Pixels "CDATA">


<!-- ========================= Parameter Entities ======================= -->

<!ENTITY % head.misc
    "theme|title|meta|link|stylesheet|javascript">

<!ENTITY % heading
    "h1|h2|h3|h4|h5|h6">

<!ENTITY % list
    "ul|ol">

<!ENTITY % preformatted
    "pre">


<!-- ========================= Generic Attributes ======================= -->

<!ENTITY % coreattrs
 "id          ID             #IMPLIED
  class       CDATA          #IMPLIED
  style       %StyleSheet;   #IMPLIED
  title       %Text;         #IMPLIED">

<!ENTITY % i18n
 "lang        %LanguageCode; #IMPLIED
  dir         (ltr|rtl)      #IMPLIED">

<!ENTITY % events
 "onclick     %Script;       #IMPLIED
  ondblclick  %Script;       #IMPLIED
  onmousedown %Script;       #IMPLIED
  onmouseup   %Script;       #IMPLIED
  onmouseover %Script;       #IMPLIED
  onmousemove %Script;       #IMPLIED
  onmouseout  %Script;       #IMPLIED
  onkeypress  %Script;       #IMPLIED
  onkeydown   %Script;       #IMPLIED
  onkeyup     %Script;       #IMPLIED">


<!-- ========================= Scriptsuft Attributes =================== -->

<!ENTITY % scriptsuftattrs
 "wml-if      CDATA          #IMPLIED
  wml-bind    CDATA          #IMPLIED
  wml-repeat  CDATA          #IMPLIED
  wml-as      CDATA          #IMPLIED">

<!ENTITY % attrs
    "%coreattrs; %i18n; %events; %scriptsuftattrs;">


<!-- ========================= Text Markup =============================== -->

<!ENTITY % fontstyle
    "tt|i|b|big|small">

<!ENTITY % phrase
    "em|strong|dfn|code|samp|kbd|var|cite|abbr|acronym">

<!ENTITY % special
    "a|img|br|break|map|q|sub|sup|span|bdo">

<!ENTITY % formctrl
    "input|select|textarea|label|button|checkbox">

<!ENTITY % inline
    "#PCDATA | %fontstyle; | %phrase; | %special; | %formctrl;">


<!-- ========================= Formatting Elements ====================== -->

<!ELEMENT (%fontstyle;|%phrase;) - - (%inline;)*>
<!ATTLIST (%fontstyle;|%phrase;) %attrs;>

<!ELEMENT (sub|sup) - - (%inline;)*>
<!ATTLIST (sub|sup) %attrs;>

<!ELEMENT span - - (%inline;)*>
<!ATTLIST span %attrs;>

<!ELEMENT bdo - - (%inline;)*>
<!ATTLIST bdo
    %coreattrs;
    lang %LanguageCode; #IMPLIED
    dir  (ltr|rtl)      #REQUIRED
>


<!-- ========================= Basic Breaks ============================= -->

<!ELEMENT br - O EMPTY>
<!ATTLIST br %coreattrs;>

<!ELEMENT break - O EMPTY>
<!ATTLIST break
    %coreattrs;
>


<!-- ========================= Block Content ============================ -->

<!ENTITY % block
    "p | %heading; | %list; | %preformatted; |
     dl | div | noscript | blockquote | form |
     line | table | address">

<!ENTITY % flow
    "%block; | %inline;">


<!-- ========================= Document Body ============================ -->

<!ELEMENT body O O (%block;|javascript)+ +(ins|del)>

<!ATTLIST body
    %attrs;
    onload  %Script; #IMPLIED
    onunload %Script; #IMPLIED
>


<!-- ========================= Block Elements ============================ -->

<!ELEMENT address - - (%inline;)*>
<!ATTLIST address %attrs;>

<!ELEMENT div - - (%flow;)*>
<!ATTLIST div %attrs;>


<!-- ========================= Anchor ==================================== -->

<!ENTITY % Shape "(rect|circle|poly|default)">
<!ENTITY % Coords "CDATA">

<!ELEMENT a - - (%inline;)* -(a)>

<!ATTLIST a
    %attrs;
    charset     %Charset;      #IMPLIED
    type        %ContentType;  #IMPLIED
    name        CDATA          #IMPLIED
    href        %URI;          #IMPLIED
    hreflang    %LanguageCode; #IMPLIED
    rel         %LinkTypes;    #IMPLIED
    rev         %LinkTypes;    #IMPLIED
    accesskey   %Character;    #IMPLIED
>


<!-- ========================= Headers ================================== -->

<!ELEMENT h1 (#PCDATA)>
<!ELEMENT h2 (#PCDATA)>
<!ELEMENT h3 (#PCDATA)>
<!ELEMENT h4 (#PCDATA)>
<!ELEMENT h5 (#PCDATA)>
<!ELEMENT h6 (#PCDATA)>


<!-- ========================= Text ===================================== -->

<!ELEMENT p (#PCDATA)>

<!ELEMENT mp (p)+>

<!ELEMENT text (#PCDATA)>

<!ELEMENT code (#PCDATA)>

<!ELEMENT pre (#PCDATA)


<!-- ========================= Lists ==================================== -->

<!ELEMENT ul ANY>
<!ELEMENT ol ANY>
<!ELEMENT dl ANY>


<!-- ========================= Media ==================================== -->

<!ELEMENT img EMPTY>

<!ATTLIST img
    %attrs;
    src     %URI;          #REQUIRED
    alt     %Text;         #REQUIRED
    longdesc %URI;         #IMPLIED
>


<!ELEMENT map ANY>

<!ELEMENT q (%inline;)*>
<!ATTLIST q %attrs;>


<!-- ========================= Forms ==================================== -->

<!ELEMENT input EMPTY>

<!ELEMENT select ANY>

<!ELEMENT textarea (#PCDATA)>

<!ELEMENT label ANY>

<!ELEMENT button ANY>

<!ELEMENT checkbox EMPTY>

<!ATTLIST checkbox
    %attrs;
    name      CDATA     #REQUIRED
    value     CDATA     #IMPLIED
    checked   (checked) #IMPLIED
    disabled  (disabled) #IMPLIED
    tabindex  NUMBER    #IMPLIED
>


<!-- ========================= Separators =============================== -->

<!--
    line:
    Scriptsuft's semantic horizontal divider.
    WML's replacement for hr.
-->

<!ELEMENT line - O EMPTY>

<!ATTLIST line
    %coreattrs;
    %scriptsuftattrs;
    weight (thin|medium|thick) medium
>


<!-- ========================= Theme ==================================== -->

<!--
    theme:
    Scriptsuft styling declaration.
    Targets a specific element and assigns a color.
-->

<!ELEMENT theme EMPTY>

<!ATTLIST theme
    target IDREF #REQUIRED
    color  CDATA #REQUIRED
>


<!-- ========================= Document Head ============================= -->

<!ELEMENT head O O
    (title|meta|link|stylesheet|javascript|theme)*>

<!ATTLIST head
    %i18n;
    charset %Charset; #IMPLIED
>


<!-- ========================= Title ==================================== -->

<!ELEMENT title - - (#PCDATA)>

<!ATTLIST title
    %i18n;
>


<!-- ========================= Metadata ================================ -->

<!ELEMENT meta - O EMPTY>

<!ATTLIST meta
    %i18n;
    http-equiv CDATA          #IMPLIED
    name       CDATA          #IMPLIED
    content    CDATA          #REQUIRED
    scheme     CDATA          #IMPLIED
    charset    %Charset;      #IMPLIED
>


<!-- ========================= Link ===================================== -->

<!ELEMENT link - O EMPTY>

<!ATTLIST link
    %attrs;
    charset     %Charset;      #IMPLIED
    href        %URI;          #IMPLIED
    hreflang    %LanguageCode; #IMPLIED
    type        %ContentType;  #IMPLIED
    rel         %LinkTypes;    #IMPLIED
    rev         %LinkTypes;    #IMPLIED
    media       %MediaDesc;    #IMPLIED
>


<!-- ========================= Stylesheet =============================== -->

<!ELEMENT stylesheet - - (#PCDATA)>

<!ATTLIST stylesheet
    %i18n;
    type   %ContentType; #REQUIRED
    media  %MediaDesc;   #IMPLIED
    title  %Text;        #IMPLIED
>


<!-- ========================= JavaScript =============================== -->

<!ELEMENT javascript - - (#PCDATA)>

<!ATTLIST javascript
    type   %ContentType; #REQUIRED
    src    %URI;         #IMPLIED
    defer  (defer)       #IMPLIED
>


<!-- ========================= Tables =================================== -->

<!ELEMENT table - - (caption?, tr+)>

<!ATTLIST table
    %attrs;
    summary     %Text;    #IMPLIED
    width       %Length;  #IMPLIED
    border      %Pixels;  #IMPLIED
    cellspacing %Length;  #IMPLIED
    cellpadding %Length;  #IMPLIED
>

<!ELEMENT caption - - (%inline;)*>
<!ATTLIST caption %attrs;>

<!ELEMENT tr - O (th|td)+>
<!ATTLIST tr %attrs;>

<!ELEMENT (th|td) - O (%flow;)*>

<!ATTLIST (th|td)
    %attrs;
    colspan NUMBER "1"
    rowspan NUMBER "1"
>


<!-- ========================= Root Element ============================= -->

<!ELEMENT wml - - (head, body)>

<!ATTLIST wml
    version CDATA "0.5"
>


<!-- =====================================================================
     Scriptsuft-specific note

     The following WML Alpha 0.5 elements are deliberately NOT part of
     Scriptsuft:

       object
       imp
       comp
       use
       slot
       state
       bind
       rep
       if
       else
       route
       tok

     fieldset is also not included because WML Alpha 0.5 explicitly
     states that it has no WML-native replacement.

     Scriptsuft therefore retains the simpler markup foundation rather
     than carrying over WML's experimental component/state system.
     ===================================================================== -->